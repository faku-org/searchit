{
  "name": "searchit",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": ["server", "packages/*"],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && bun run --cwd server typecheck",
    "lint": "oxlint .",
    "server": "bun run --cwd server dev",
    "bundle:server": "bun scripts/bundle-server.mjs && bun scripts/fetch-bun-sidecar.mjs",
    "bundle:inference": "bun scripts/bundle-inference.mjs",
    "db:generate": "bun run --cwd server db:generate",
    "db:migrate": "bun run --cwd server db:migrate"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/ibm-plex-serif": "^5.2.7",
    "@searchit/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "autoprefixer": "^10.5.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "postcss": "^8.5.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "oxlint": "^0.15.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
