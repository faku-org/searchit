# Optional. When unset, the server uses an embedded PGlite database (no
# Docker/Postgres install needed) stored under SEARCHIT_DB_DIR. Set this to
# point at an external Postgres instead (e.g. `docker-compose up -d`).
# DATABASE_URL=postgres://searchit:searchit@localhost:5432/searchit
SEARCHIT_DB_DIR=../data/pgdata
SEARCHIT_WATCH_DIR=../data/incoming
SEARCHIT_PREVIEW_DIR=../data/previews
SEARCHIT_FACE_THUMBNAIL_DIR=../data/face-thumbnails
INFERENCE_URL=http://localhost:8000
FACE_MATCH_MAX_DISTANCE=0.6
FACE_MIN_CONFIDENCE=0.6
# Both optional, default true. Set to "false" to skip that stage of the
# ingest pipeline entirely (see server/src/ingest/pipeline.ts) -- the Tauri
# desktop app sets these from the Settings UI instead of .env.
# FACE_RECOGNITION_ENABLED=true
# VISUAL_SEARCH_ENABLED=true
PORT=3001
HOST=127.0.0.1
